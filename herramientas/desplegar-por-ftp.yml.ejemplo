# Publie le site sur O2switch à chaque modification de la branche main :
# aussi bien un commit du panel du refuge qu'un push de développement.
# Les identifiants FTP vivent dans Settings → Secrets and variables → Actions.
name: Publicar en O2switch

on:
  push:
    branches: [main]
  workflow_dispatch:

# Une seule publication à la fois : deux fiches enregistrées coup sur coup
# se suivent au lieu de se marcher dessus.
concurrency:
  group: desplegar
  cancel-in-progress: false

permissions:
  contents: read

jobs:
  desplegar:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v4

      - name: Construir el sitio
        env:
          DESTINO: o2switch
          # "preprod" (bandeau + noindex) hasta el lanzamiento. Para pasar a
          # producción: Settings → Variables → MODO = produccion
          MODO: ${{ vars.MODO || 'preprod' }}
          SITE_URL: ${{ vars.SITE_URL }}
        run: python3 build-preprod.py

      - name: Subir por FTPS
        env:
          FTP_HOST: ${{ secrets.FTP_HOST }}
          FTP_USER: ${{ secrets.FTP_USER }}
          FTP_PASSWORD: ${{ secrets.FTP_PASSWORD }}
          FTP_DIR: ${{ vars.FTP_DIR }}
          FTP_VERIFY_TLS: ${{ vars.FTP_VERIFY_TLS || '1' }}
        run: python3 deploy-ftp.py dist/preprod
